<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local Telegram Bot API server for polygram (2 GB file send/receive).

  Companion daemon — NOT part of polygram. Localhost-only: it makes
  OUTBOUND connections to Telegram's datacenters; nothing external
  connects to it (no public port, no webhook, no exposure).

  Setup (do these first — see docs/0.12.0-file-send.md):
    1. Get TELEGRAM_API_ID + TELEGRAM_API_HASH from https://my.telegram.org
    2. Install the binary: ops/setup-telegram-bot-api.sh  (builds it; not on Homebrew)

  Then:
    - replace API_ID_HERE / API_HASH_HERE / the binary path below
    - cp this to ~/Library/LaunchAgents/com.telegram.bot-api.plist
    - launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.telegram.bot-api.plist
    - set config.bot.apiRoot = "http://localhost:8081" and restart polygram
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.telegram.bot-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/telegram-bot-api</string>
        <string>--api-id=API_ID_HERE</string>
        <string>--api-hash=API_HASH_HERE</string>
        <!-- bind to loopback ONLY — never 0.0.0.0 -->
        <string>--http-ip-address=127.0.0.1</string>
        <string>--http-port=8081</string>
        <!-- --local enables 2 GB limits + local-file paths -->
        <string>--local</string>
        <string>--dir=/Users/ivanshumkov/.telegram-bot-api</string>
        <string>--temp-dir=/Users/ivanshumkov/.telegram-bot-api/tmp</string>
        <string>--log=/Users/ivanshumkov/.telegram-bot-api/server.log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ivanshumkov/.telegram-bot-api</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/ivanshumkov/.telegram-bot-api/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ivanshumkov/.telegram-bot-api/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/ivanshumkov</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
